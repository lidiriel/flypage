#: data/io.github.flypage.Processing.desktop.in:3
#: data/io.github.flypage.Settings.desktop.in:3
#: data/io.github.flypage.metainfo.xml.in:6 flypage/ui/processing_window.py:126
msgid "Flypage"
msgstr "Flypage"

#: data/io.github.flypage.Processing.desktop.in:4
msgid "Sort scans into folders and make them searchable PDFs"
msgstr "Trie les scans dans des dossiers et en fait des PDF interrogeables"

#: data/io.github.flypage.Settings.desktop.in:4
msgid "Scan Import"
msgstr "Import de scans"

#: data/io.github.flypage.Settings.desktop.in:5
#: data/io.github.flypage.metainfo.xml.in:7
msgid "Turn the scans of a scanner with memory into searchable PDFs"
msgstr "Transforme les scans d'un scanner à mémoire en PDF interrogeables"

#. Translators: search terms, separated by semicolons
#: data/io.github.flypage.Settings.desktop.in:7
msgid "scan;scanner;OCR;PDF;IRIScan;"
msgstr "scan;scanner;numériser;OCR;PDF;IRIScan;"

#: data/io.github.flypage.metainfo.xml.in:9
msgid ""
"Plug in a scanner with internal memory, such as an IRIScan Book, and Flypage "
"copies its scans and opens a window where you sort them: drag them onto a "
"folder and they become PDFs with an invisible text layer, so you can search "
"and copy their text."
msgstr ""
"Branchez un scanner à mémoire interne, comme un IRIScan Book : Flypage copie "
"ses scans et ouvre une fenêtre où vous les triez. Glissez-les sur un dossier "
"et ils deviennent des PDF avec une couche de texte invisible, pour pouvoir "
"chercher et copier leur texte."

#: data/io.github.flypage.metainfo.xml.in:16
msgid "PNG, JPEG and PDF scans"
msgstr "Scans PNG, JPEG et PDF"

#: data/io.github.flypage.metainfo.xml.in:17
msgid "Move or copy, to a set folder or any other one"
msgstr "Déplacer ou copier, vers un dossier prédéfini ou n'importe quel autre"

#: data/io.github.flypage.metainfo.xml.in:18
msgid "File names from a template with dates and numbers"
msgstr "Noms de fichier à partir d'un modèle avec dates et numéros"

#: data/io.github.flypage.metainfo.xml.in:19
msgid "OCR with Tesseract, in the languages of your choice"
msgstr "OCR avec Tesseract, dans les langues de votre choix"

#: data/io.github.flypage.metainfo.xml.in:20
msgid "Scans deleted from the scanner once converted, if you want"
msgstr "Scans supprimés du scanner une fois convertis, si vous le souhaitez"

#: flypage/__main__.py:14
msgid ""
"Import documents from a scanner's memory and turn them into searchable PDFs."
msgstr ""
"Importe les documents de la mémoire d'un scanner et les transforme en PDF "
"interrogeables."

